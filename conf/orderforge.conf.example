# OrderForge configuration (example).
# Copy to conf/orderforge.conf (scripts/setup-db.sh does this) and keep it mode 0600.
# The real file holds secrets and is git-ignored.

# ---- MySQL (used by of-core, of-ctl and of-bench; of-api never touches the database)
db.host     = localhost
db.port     = 3306
db.user     = orderforge
db.password = CHANGE_ME
db.name     = orderforge
# Leave db.socket unset to use the client default (/var/run/mysqld/mysqld.sock).

# ---- runtime files: pid files (flock-locked), supervisor status, by default the socket
run.dir = run
# If a daemon is started as root it switches to this account before opening any file
# (and refuses to run as root when this is unset). Ignored when not started as root.
# run.user = orderforge
# Core dumps are disabled (they would contain the secrets below). 1 keeps them, for
# debugging only.
run.core_dumps = 0

# ---- logging: one JSON-lines file per process in log.dir ("-" logs to stderr)
log.dir   = run/log
log.level = info

# ---- of-core (the engine)
# Unix socket of-api connects to (mode 0660; peers are checked with SO_PEERCRED).
core.socket = run/of-core.sock
# Worker threads, each with its own MySQL connection. Default: one per CPU core.
# core.workers = 8
# Bounded job queue. When full, requests are answered 503 "busy" at once (backpressure).
core.queue_size = 1024
# A request that waited longer than this in the queue is answered 503 without running.
core.job_timeout_ms = 10000
# Requests slower than this are logged with their trace id.
core.slow_ms = 500
# POSIX shared-memory stock table (visible in /dev/shm) and its capacity in products.
core.shm_name = /orderforge
core.stock_capacity = 4096
# Extra uid allowed to connect to the core socket (default: only our own uid).
# core.allow_uid = 33
# How often the reservation-expiry reaper runs (a timerfd in of-core).
core.reaper_interval_ms = 1000
# Threads applying payment replies (each with its own MySQL connection).
core.payment_workers = 4
# Write-ahead log for in-flight stock reservations (lockfree-shm): its file, how long
# the flusher lingers to batch records into one fdatasync, and the size that triggers
# compaction.
core.wal_path      = run/of-core.wal
core.wal_group_us  = 2000
core.wal_max_bytes = 16777216

# ---- of-api (pre-forked FastCGI workers behind Apache)
api.listen  = 127.0.0.1:9000
# Each worker holds one connection to of-core, so this caps requests in flight.
api.workers = 16
# Give up on of-core after this long and answer 502.
api.core_timeout_s = 30
# Rate limits (token buckets in shared memory, shared by all of-api workers).
# Over a limit: 429 with Retry-After. api.rate_limit = 0 turns them off.
api.rate_limit         = 1
api.rate_ip_per_s      = 500
api.rate_ip_burst      = 2000
api.rate_session_per_s = 20
api.rate_session_burst = 40
# Login and registration, per client IP: slows password guessing across accounts.
api.rate_auth_per_min  = 30
api.rate_auth_burst    = 30
api.rate_shm_name      = /orderforge-rl

# ---- stock protection: naive | db-lock | lockfree-shm   (of-core -m overrides it)
#   naive         unsafe read-modify-write: the benchmark baseline, oversells under load
#   db-lock       SELECT ... FOR UPDATE + guarded update: correct, serialises in MySQL
#   lockfree-shm  CAS reservation in shared memory + guarded update: correct and fastest
store.stock_mode = lockfree-shm
# Extra delay inside the naive read-modify-write, in microseconds. Widens the race
# window for demonstrations; keep 0 for normal use.
store.naive_delay_us = 0
# An unpaid order holds its stock this long; then the reaper cancels it.
store.reservation_ttl_s = 120

# ---- payments: of-core <-> of-pay over two POSIX message queues (/dev/mqueue)
# Shared secret for the HMAC-SHA256 on every payment message: 64 hex characters.
# scripts/setup-db.sh generates it; or: echo "pay.hmac_key = $(openssl rand -hex 32)"
pay.hmac_key = CHANGE_ME
pay.request_queue = /orderforge-pay-req
pay.reply_queue   = /orderforge-pay-rep
# Messages per queue. Unprivileged processes are limited to /proc/sys/fs/mqueue/msg_max
# (10 by default); of-core buffers bursts in an in-memory outbox of pay.outbox_size.
pay.mq_maxmsg   = 10
pay.outbox_size = 8192
# Mock gateway behaviour: normal reply latency, the tok_slow delay (keep it longer than
# store.reservation_ttl_s to demonstrate late-payment refunds), and the tok_random mix.
pay.latency_min_ms = 20
pay.latency_max_ms = 150
pay.slow_ms        = 180000
pay.decline_pct    = 10
pay.timeout_pct    = 5
pay.duplicate_pct  = 5

# ---- of-report
report.dir        = run/reports
report.interval_s = 10
report.days       = 30

# ---- of-supervisor (scripts/run.sh)
# A daemon that crashes more than max_restarts times within window_s seconds is not
# restarted again ("degraded") until `of-ctl reload`. stop_timeout_s: how long each
# daemon may take to drain on shutdown before SIGKILL.
supervisor.max_restarts   = 5
supervisor.window_s       = 60
supervisor.stop_timeout_s = 15

# ---- authentication
auth.session_ttl   = 86400
# Set to 1 once Apache serves the site over HTTPS (adds the Secure cookie flag).
auth.cookie_secure = 0
